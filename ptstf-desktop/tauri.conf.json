{
  "build": {
    "distDir": "src",
    "devPath": "src/index.html",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "package": {
    "productName": "ptstf-desktop",
    "version": "1.1.0"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.ptstf.desktop",
      "icon": []
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "PTSTF Visualizer v1.1",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
